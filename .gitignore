# Only the two app folders (plus repo-level docs) belong in this repo
/*
!/.gitignore
!/README.md
!/website/
!/intake-api/

# Build output and dependencies
node_modules/
.next/
dist/
build/

# Secrets
.env*
!.env.example
*.pem
*.key

# Anbaric local state (app-config.json is tracked deliberately)
.anbaric/*
!.anbaric/app-config.json
